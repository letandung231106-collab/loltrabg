# ==============================================================================
# NIGHT MOVIE CINEMA MANAGEMENT - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành '.env' và điền các giá trị phù hợp với môi trường của bạn.
# TUYỆT ĐỐI KHÔNG commit file .env chứa giá trị thật lên kho mã nguồn Git.
# ==============================================================================

# 1. Cấu hình máy chủ REST API
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DEPLOY_DOMAIN=https://your-production-domain.com

# 2. Cấu hình Cơ Sở Dữ Liệu MySQL (Yêu cầu MySQL 8.0+ InnoDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinema_management
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 3. Cấu hình JWT (JSON Web Token Authentication)
# BẮT BUỘC: Thay đổi chuỗi bí mật ngẫu nhiên mạnh (tối thiểu 32 ký tự) khi triển khai Production
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# 4. Nghiệp vụ rạp chiếu phim
SEAT_HOLD_MINUTES=10

# 5. Cờ tính năng bảo mật môi trường (Security Feature Flags)
# ENABLE_DEMO_TOOLS: Cho phép tính năng chuyển vai trò 1-click (switch-role).
# CẢNH BÁO: CHỈ BẬT KHI DEMO CỤC BỘ (true). Môi trường Production bắt buộc để false hoặc tắt hoàn toàn.
ENABLE_DEMO_TOOLS=true

# ENABLE_MOCK_PAYMENT: Cho phép cổng thanh toán mô phỏng trực tiếp (/api/payments/process).
# Cần bật (true) trong môi trường dev cục bộ để frontend thử nghiệm thanh toán giả lập.
ENABLE_MOCK_PAYMENT=true

# 6. Cổng thanh toán MoMo Sandbox v2 & HMAC-SHA256
# BẮT BUỘC: Điền thông tin tài khoản đối tác MoMo Sandbox / Production
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173
MOMO_IPN_URL=http://localhost:5050/api/payments/momo/ipn

# 7. Cấu hình AI Assistant (CinemaBot AI)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_optional_openai_api_key
